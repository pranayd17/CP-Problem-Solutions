class Solution {
public:
    int minOperations(vector<vector<int>>& grid, int x) {
        int t=grid[0][0]%x;
        vector<int> v;
        for(int i=0;i<grid.size();i++){
            for(int j=0;j<grid[0].size();j++){
                int t1=grid[i][j]%x;
                if(t!=t1) return -1;
                v.push_back(grid[i][j]);
            }
        }
        sort(v.begin(),v.end());
        int n=v.size();
        int res=v[n/2];
        int c=0;
        for(int i=0;i<v.size();i++){
            int diff=abs(v[i]-res);
            c+=diff/x;
        }
        return c;
    }
};
